{
  "name": "miuzika",
  "version": "0.10.0",
  "private": true,
  "type": "module",
  "description": "DAW web con asistente LLM, Strudel y motor de audio openDAW",
  "license": "AGPL-3.0-or-later",
  "keywords": [
    "daw",
    "music",
    "llm",
    "strudel",
    "opendaw",
    "midi"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "compose": "node src/cli/index.ts",
    "test": "node --test \"src/**/*.test.ts\" \"web/**/*.test.ts\" && node scripts/bundle-run.mjs src/host/opendaw/check.ts tmp/opendaw-check.mjs",
    "test:unit": "node --test \"src/**/*.test.ts\" \"web/**/*.test.ts\"",
    "test:opendaw": "node scripts/bundle-run.mjs src/host/opendaw/check.ts tmp/opendaw-check.mjs",
    "eval": "node src/cli/eval.ts",
    "typecheck": "tsc --noEmit",
    "dev": "vite",
    "preview": "vite preview",
    "build:web": "vite build",
    "drums:build": "node scripts/make-drums.ts",
    "export:opendaw": "node scripts/bundle-run.mjs src/host/opendaw/export-cli.ts tmp/opendaw-export.mjs"
  },
  "dependencies": {
    "@opendaw/lib-dom": "^0.0.92",
    "@opendaw/lib-dsp": "^0.0.96",
    "@opendaw/lib-std": "^0.0.87",
    "@opendaw/studio-adapters": "^0.3.7",
    "@opendaw/studio-boxes": "^0.0.113",
    "@opendaw/studio-core": "^0.2.9",
    "@opendaw/studio-core-wasm": "^0.0.20",
    "@strudel/core": "^1.2.6",
    "@strudel/mini": "^1.2.6",
    "@strudel/soundfonts": "^1.3.0",
    "@strudel/tonal": "^1.2.6",
    "@strudel/transpiler": "^1.2.6",
    "@strudel/webaudio": "^1.3.0",
    "fflate": "^0.8.3",
    "superdough": "^1.3.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.0",
    "vite": "^8.3.4"
  }
}
