{
  "name": "miuzika",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Experimental browser music workstation on openDAW, with generative modules and no LLM between the interface and the models",
  "license": "AGPL-3.0-or-later",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node --test \"src/**/*.test.ts\" \"web/**/*.test.ts\" \"server/**/*.test.ts\" && node scripts/bundle-run.mjs src/host/opendaw/check.ts tmp/opendaw-check.mjs",
    "test:unit": "node --test \"src/**/*.test.ts\" \"web/**/*.test.ts\" \"server/**/*.test.ts\"",
    "test:opendaw": "node scripts/bundle-run.mjs src/host/opendaw/check.ts tmp/opendaw-check.mjs",
    "typecheck": "tsc --noEmit",
    "dev": "vite",
    "build:web": "vite build"
  },
  "dependencies": {
    "@opendaw/lib-dom": "^0.0.92",
    "@opendaw/lib-dsp": "^0.0.96",
    "@opendaw/lib-std": "^0.0.87",
    "@opendaw/studio-adapters": "^0.3.7",
    "@opendaw/studio-boxes": "^0.0.113",
    "@opendaw/studio-core": "^0.2.9",
    "@opendaw/studio-core-wasm": "^0.0.20",
    "@strudel/core": "^1.2.6",
    "@strudel/mini": "^1.2.6",
    "@strudel/soundfonts": "^1.3.0",
    "@strudel/tonal": "^1.2.6",
    "@strudel/transpiler": "^1.2.6",
    "@strudel/webaudio": "^1.3.0",
    "fflate": "^0.8.3",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.0",
    "vite": "^8.3.4"
  }
}
